# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 覆盖率产物（coverage.py 数据文件；HTML 报告生成到 .trae/htmlcov，已被上面忽略）
.coverage
htmlcov/

# 虚拟环境
venv/
.venv/
env/
ENV/

# 环境变量与密钥（不要提交）
.env
.env.local
*.key
*.pem

# Django
db.sqlite3
media/
staticfiles/

# 日志
*.log

# 后端 B 运行时生成的历史对话记录（接口格式见 backend_B/README.md）
# 每个组员跑一次就多一份自己的对话数据，提交上来只会互相冲突
backend_B/data/history.csv

# 后端 B 的预合成语音缓存（语音输出，见 backend_B/README.md §4.8）
# 由语音引擎按本机音色自动生成、换配置自动失效，机器之间不可复用
backend_B/data/tts_cache/

# 家属门户的落盘数据库（B 运行时持续写入，WAL/-shm/-wal 同源生成；
# 演示版无自动清理，只适合短期保留约 7 天数据 —— 方案文档【范围与说明】）
backend_B/data/family_data.sqlite3*

# Trae 本地文档（实现方案、会话产物），不属于代码交付物
.trae/

# IDE
.idea/
.vscode/
*.swp

# 操作系统
.DS_Store
Thumbs.db

# 前端（如果 frontend_C 用 Node）
node_modules/
dist/
build/

# 语音模型（vosk 中文模型约 40MB，是下载来的二进制，不入库）
# 位置：backend_B/models/<模型目录名>/
backend_B/models/

# 后端A采集数据（只保留交付 B 的 4 标签样例 + 一份 rPPG 波形样例）
backend_A/data/*
!backend_A/data/vis_data_20260922_154601.csv
# rPPG 波形样例：本仓库唯一一份真实波形数据（1563 帧 / HR=75bpm / SQI=1.0，
# hr 有值 93%、ibi 82%），给 api_doc §3.5 那个仍标着「未确认」的 rPPG 字段
# 提案当实证。GYZ 当初只留了 4 标签样例、没留波形样例。
!backend_A/data/pulse_wave_20260929_181230.csv
backend_A/baseline.json

# 模块A 模型权重（体积大，不进版本库，见 backend_A/README.md 下载说明）
backend_A/models/

# Claude Code 的本地配置（.claude/settings.json 里的权限白名单是**本机**的、
# 而且可能是从别的项目带过来的，对别人没有意义，不入库）
.claude/

# Generi-Chan 形象的设计工程源文件（Live2D .cmo3 / Krita .psd / Inkscape .svg
# 与导出 PNG，共约 78MB）。代码零引用，属于美术同学生产工具的本地文件，
# 体积远超 git 承受范围，不入库。
Generi-Chan/

# 项目报告：生成脚本（python-docx）与产出的 Word 文档。
# 课程交付物，不随代码仓库分发；脚本留在本地按需重新生成。
generate_report.py
项目报告.docx
